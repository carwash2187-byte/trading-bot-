# Anything the bot writes while running. None of this belongs in a repo —
# the journal and state files describe real positions and real balances.
#
# The leading slashes matter and are not cosmetic. Written bare, "data/"
# matches a directory of that name at ANY depth, so it also excluded
# tradebot/data/ -- the indicators package -- and the repository was pushed
# without code the bot cannot start without. Nothing reported it: the files
# were present locally, the tests passed locally, and only a clean checkout
# elsewhere failed, on an import error that says nothing about gitignore.
/run/
/data/
/logs/
*.log
*.jsonl
*.lock
*.corrupt.*

# Credentials. There should never be a broker password in here, but if one
# ever lands in a .env this stops it leaving the machine.
.env
.env.*
secrets.json
credentials.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# macOS
.DS_Store

# Cached market history. Re-downloadable for free; no reason to version 1MB+
# of exchange candles that never change.
data/history/

# Daily account record — real balances, not for sharing
reports/
